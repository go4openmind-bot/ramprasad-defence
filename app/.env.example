# =============================================================================
# app/.env.example — copy to app/.env.local and fill in. Never commit .env.local.
# Names and placeholders only. No real keys here, ever.
# =============================================================================

# Supabase project URL (server-side). Example: https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (the anon/public key). Safe for client use, but this
# app uses it server-side only, so it is NOT prefixed with NEXT_PUBLIC_.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase secret key (service_role). SERVER-SIDE ONLY.
# Do NOT prefix with NEXT_PUBLIC_. Do NOT import into browser code.
# The running app does not use this; only a trusted admin script would.
SUPABASE_SECRET_KEY=your-secret-key-not-used-by-the-app

# Private Storage bucket that holds documents.
SUPABASE_DOCUMENTS_BUCKET=documents
