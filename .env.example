# =============================================================================
# .env.example — Ramprasad Defence
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# NEVER put real keys in this file or any committed file.
# =============================================================================

# --- Supabase (server-side only; service key must never reach a browser) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase database connection (for migrations / scripts) ---
DATABASE_URL=

# --- n8n (workflow automation) ---
N8N_BASE_URL=
N8N_API_KEY=

# --- Outbound email / alerts ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_ADDRESS=

# --- Application settings (non-secret) ---
APP_ENV=development
DEFAULT_CURRENCY=INR
